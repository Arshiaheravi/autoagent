# Agent sandbox image (Fork A) — the per-tenant container a session runs in.
#
# Contract: the control plane launches this via sandbox.ContainerRunner, which
# passes the full `claude -p …` argv, mounts the tenant's volume at /workspace,
# and injects ONLY the tenant's BYOK key as -e ANTHROPIC_API_KEY. Nothing secret
# is baked into the image; the master vault key never enters the container.
#
# Hardening lives at run time (sandbox.ContainerRunner: --user, --read-only,
# --cap-drop ALL, no-new-privileges, resource caps); the image just ships a
# non-root user and the two runtimes the session needs.

FROM node:22-bookworm-slim

# Python is only for the engine's session hooks (session_hooks.py) — stdlib only
# inside the sandbox; the control-plane libs (psycopg, cryptography) are NOT here.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# The Claude Code CLI — the executor the session drives.
RUN npm install -g @anthropic-ai/claude-code && npm cache clean --force

# Engine on PYTHONPATH so `claude --settings` hooks resolve. Stays ROOT-owned and
# read-only to the tenant (0755) — the session must not be able to rewrite the
# engine code it runs under.
COPY engine/ /opt/autoagent/engine/
ENV PYTHONPATH=/opt/autoagent/engine \
    PYTHONUNBUFFERED=1 \
    AUTOAGENT_HOME=/workspace/.autoagent \
    HOME=/workspace/.home \
    XDG_CONFIG_HOME=/workspace/.home/.config \
    XDG_CACHE_HOME=/workspace/.home/.cache

# Unprivileged user; uid matches sandbox.ContainerRunner's --user default (10001).
# Only /workspace (the mounted volume) is tenant-owned/writable; the runtime
# --read-only root FS makes everything else immutable, so HOME lives on the volume.
RUN useradd -u 10001 -s /usr/sbin/nologin agent \
    && mkdir -p /workspace \
    && chown -R 10001:10001 /workspace
USER 10001:10001
WORKDIR /workspace

# Bare `docker run` is harmless — the real command is supplied by the runner.
CMD ["claude", "--help"]
